figure.figsize: 16, 8
font.size: 22
axes.titlesize: 24
axes.labelsize: 24
xtick.labelsize: 22
ytick.labelsize: 22
legend.fontsize: 20
legend.title_fontsize: 22
lines.markersize: 18
lines.linewidth: 3
text.usetex: True
font.family: serif
font.serif: Times New Roman, Times
# Times-matching math glyphs for the mathtext fallback when no LaTeX is
# installed, so `$k$` does not render in DejaVu Sans. Ignored under usetex.
mathtext.fontset: stix
